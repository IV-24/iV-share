# Copy to backend/.env (git-ignored) and fill in. Nothing here is read at
# import time — every value is looked up through
# core/configuration/settings.py at runtime.

# ---- Required ----------------------------------------------------------
# Gates /api/chat, /status, and /approvals/*. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_ACCESS_SECRET=

# ---- Model providers (set whichever you have; iV runs with none, degraded)
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---- Server ------------------------------------------------------------
# 0.0.0.0 is the default and is what makes the phone-over-Tailscale case
# work. Set 127.0.0.1 for a laptop-only install.
# IV_HOST=0.0.0.0
# IV_PORT=8024
# IV_DEV=1                      # uvicorn auto-reload; development only
# IV_SHUTDOWN_GRACE_SECONDS=15
# IV_LOG_LEVEL=INFO
# IV_LOG_FORMAT=text            # or "json"

# ---- Storage / workspace ----------------------------------------------
# IV_LOCAL_DB_PATH=/absolute/path/to/iv.db     # default: <install-dir>/iv.db
# IV_WORKSPACE_ROOT=/absolute/path/to/workspace # default: <install-dir>/workspace

# ---- Safety ------------------------------------------------------------
# Branches iV will never commit to or push. Comma-separated. Defaults to
# main,master,production,release. iV has no tool that can change this.
# IV_PROTECTED_BRANCHES=main,master,production,release

# ---- CORS --------------------------------------------------------------
# Only needed if a browser calls the API cross-origin. The bundled
# frontend proxies through its own server, so normally leave these unset.
# CORS_ALLOWED_ORIGINS=http://localhost:4024,http://127.0.0.1:4024
# CORS_ALLOWED_ORIGIN_REGEX=https://.*\.ts\.net

# ---- Sleep Cycle / self-audit triggers ---------------------------------
# Required for POST /internal/sleep-cycle and POST /internal/self-audit.
INTERNAL_TRIGGER_SECRET=
# AGENT_IV_BASE_URL=http://localhost:8024

# ---- Optional integrations --------------------------------------------
# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD=
# NOTIFY_EMAIL=
# GITHUB_TOKEN=

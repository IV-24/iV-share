# Copy to frontend/.env.local (not committed) — OPTIONAL in the normal
# same-machine setup, where every value below has a working default.
#
# Server-side only — no NEXT_PUBLIC_ prefix, so nothing here reaches the
# browser bundle. The page talks to /api/iv/* on its own origin and the
# Next.js server forwards to the API with the secret attached.

# Where the iV API is reachable FROM THE MACHINE RUNNING NEXT.JS.
# Defaults to http://127.0.0.1:8024, which is correct when both run on
# the same laptop.
# IV_API_URL=http://127.0.0.1:8024

# The API secret. Leave this UNSET on a normal install: the frontend
# reads API_ACCESS_SECRET straight out of ../backend/.env, so there is
# only one place to keep it and nothing to keep in sync. Set it only when
# the frontend runs somewhere backend/.env does not exist.
# IV_API_SECRET=

# Comma-separated hosts allowed to reach `next dev` cross-origin — e.g.
# your laptop's Tailscale IP or MagicDNS name, so your phone can load the
# page. Find it with: tailscale ip -4
# IV_ALLOWED_DEV_ORIGINS=100.x.y.z,my-laptop.tailnet-name.ts.net
